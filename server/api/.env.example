PORT=8080
JWT_SECRET=replace-me
DATABASE_URL=postgres://postgres:postgres@localhost:5432/capture3d
# To run without Postgres (in-memory dev), set:
# NO_DB=true
# Optional dashboard basic auth
DASHBOARD_BASIC_USER=admin
DASHBOARD_BASIC_PASS=admin
# To disable auth for local dev set:
# DISABLE_DASHBOARD_AUTH=true

# When running in Docker, rewrite presigned URLs to host-accessible endpoint
# Example for MinIO on host ports:
PUBLIC_S3_ENDPOINT=http://localhost:9000
